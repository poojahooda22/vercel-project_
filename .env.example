# Copy to .env at the repo root. docker compose reads it automatically and passes
# these into the containers as environment variables — they are NEVER baked into an
# image, which is why .dockerignore excludes .env from the build context.
#
# One file now, instead of one per service: compose is the single place that maps
# variables to containers, and each service still only receives what it needs.

# ---- Cloudflare R2 -----------------------------------------------------------
# Used by upload, deploy, request-handler and screenshot services.
ACCOUNT_ID=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Neon Postgres -----------------------------------------------------------
# Holds both the deployments table and Better Auth's user/session tables.
NEON_DB=

# ---- Better Auth (frontend) --------------------------------------------------
# BETTER_AUTH_SECRET signs session cookies. Changing it invalidates every session.
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub App (upload service) ---------------------------------------------
# Lets users deploy PRIVATE repositories: they install the App on their account,
# and each clone borrows a one-hour token for that one repo. Register the App at
# Settings → Developer settings → GitHub Apps with Contents: read-only, and set its
# Setup URL to <dashboard origin>/api/github/callback. One App per environment.
# The private key GitHub downloads is a multi-line PEM; env files hold one line, so
# store it base64-encoded:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
# All three or none — the service refuses a partial set.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
# The App's Webhook secret (Settings → GitHub Apps → <app> → Webhook). Pushes to a
# connected repository POST to <dashboard origin>/api/webhooks/github, signed with
# this; the receiver refuses unsigned or mis-signed deliveries. Empty disables it.
# On the App's webhook settings the content type must be application/json.
GITHUB_WEBHOOK_SECRET=

# ---- Production only (docker-compose.prod.yml) --------------------------------
# Unused locally. Set these in the .env ON THE SERVER, never in CI.
# DOMAIN is the bare domain: the dashboard becomes app.$DOMAIN and each deployment
# {id}.$DOMAIN. CF_API_TOKEN needs only DNS:Edit on that one zone — Caddy uses it
# to write the TXT record that proves control for the wildcard certificate.
DOMAIN=
ACME_EMAIL=
CF_API_TOKEN=

# ---- Not set here ------------------------------------------------------------
# REDIS_URL, FRONTEND_ORIGIN, REQUEST_HANDLER_ORIGIN and PREVIEW_HOST are set in
# docker-compose.yml instead: they describe how containers find each other on the
# internal network, which is a property of the deployment, not a secret.
