# TEMPLATE ONLY — this file IS committed. Never put real values here.
# Real values go in .env (gitignored). Nothing in the code ever reads this file.
# Run with: npm run dev   (plain `node dist/index.js` does NOT load .env)

ACCOUNT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vercel

# Optional. Without these the service accepts public GitHub URLs only. See the
# root .env.example for how to register the App and encode the key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
