# Copy to .env and fill in. Start with "npm run dev" — a bare "node dist/index.js"
# does NOT read .env, it needs --env-file=.env.

# Cloudflare R2 — the same bucket the other services use.
ACCOUNT_ID=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Neon Postgres connection string.
NEON_DB=

# Where the request handler is actually listening. The worker connects here by IP
# and sets the Host header itself, so no wildcard DNS is needed to check liveness.
REQUEST_HANDLER_ORIGIN=http://127.0.0.1:3001

# The domain deployments are served under: {id}.{PREVIEW_HOST}. Chromium resolves
# *.localhost to loopback on its own; in production this is the real wildcard domain.
PREVIEW_HOST=localhost:3001
