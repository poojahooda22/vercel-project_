# Copy to .env and fill in. .env is gitignored; this file is not.
# Cloudflare R2 exposes an S3-compatible API, so the S3 SDK talks to it directly.

# R2 account id — also forms the endpoint: https://<account-id>.r2.cloudflarestorage.com
ACCOUNT_ID=

# R2 API token credentials (Cloudflare dashboard -> R2 -> Manage API Tokens)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The bucket that holds cloned repos and build output
S3_BUCKET=vercel
